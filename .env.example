# VELOX server configuration. Copy to .env (or set in your hosting dashboard). Never commit real secrets.
NODE_ENV=production
PORT=8080

# Database — local dev uses SQLite at this path. Production: PostgreSQL + PostGIS (see docs/ARCHITECTURE.md §7).
DATABASE_FILE=./data/velox.db
# DATABASE_URL=postgres://user:password@host:5432/velox

# Object storage — local disk in dev. Production: S3-compatible bucket(s), public + private.
UPLOADS_DIR=./data/uploads
# S3_ENDPOINT=  S3_REGION=  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=  S3_PUBLIC_BUCKET=  S3_PRIVATE_BUCKET=

# Sessions
SESSION_DAYS=30
COOKIE_SECURE=true          # requires HTTPS

# Payments — 'mock' until a gateway contract is signed. Keys stay on the server only.
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=change-me
# MIDTRANS_SERVER_KEY=   MIDTRANS_CLIENT_KEY=   (or)   XENDIT_SECRET_KEY=   XENDIT_WEBHOOK_TOKEN=

# Verification-code delivery (not yet connected). While false-y providers are missing, codes are shown in a DEMO box.
EXPOSE_DEV_CODES=true       # MUST be false in a real launch
# SMTP_URL= / SENDGRID_API_KEY= / AWS_SES_REGION=
# SMS / WhatsApp: TWILIO_ACCOUNT_SID= TWILIO_AUTH_TOKEN= (or a local SMS gateway)

# Demo data is seeded automatically into an empty database.
SEED_DEMO=true
